#!/usr/bin/env python3
"""Forward container browser requests to the launching user's host desktop."""

import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlsplit

MAX_REQUEST = 65536


def open_url(url):
    if not isinstance(url, str) or len(url.encode()) > MAX_REQUEST:
        raise ValueError("invalid browser URL")
    if urlsplit(url).scheme not in ("http", "https") or any(
        ord(char) < 32 for char in url
    ):
        raise ValueError("browser relay only accepts HTTP(S) URLs")
    # Execute argv directly: Grafana queries and other URLs are never shell code.
    candidates = os.environ.get("BROWSER", "").split(os.pathsep)
    candidates.extend(("xdg-open", "gio open"))
    for candidate in candidates:
        command = shlex.split(candidate)
        if not command or not shutil.which(command[0]):
            continue
        has_placeholder = any("%s" in arg for arg in command)
        command = [arg.replace("%s", url) for arg in command]
        if not has_placeholder:
            command.append(url)
        try:
            process = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            returncode = process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            # A directly selected browser can stay alive for the whole session.
            return
        except OSError:
            continue
        if returncode == 0:
            return
    raise RuntimeError("host browser could not open URL; configure BROWSER on the host")


def serve(path):
    with socket.socket(socket.AF_UNIX) as server:
        server.bind(path)
        os.chmod(path, 0o600)
        server.listen(8)
        while True:
            connection, _ = server.accept()
            with connection:
                connection.settimeout(20)
                try:
                    data = bytearray()
                    while b"\n" not in data:
                        chunk = connection.recv(4096)
                        if not chunk:
                            raise ValueError("incomplete browser request")
                        data.extend(chunk)
                        if len(data) > MAX_REQUEST:
                            raise ValueError("browser request too large")
                    open_url(json.loads(data.split(b"\n", 1)[0]))
                    response = {"ok": True}
                except (ValueError, OSError, RuntimeError) as error:
                    response = {"ok": False, "error": str(error)}
                try:
                    connection.sendall(json.dumps(response).encode() + b"\n")
                except OSError:
                    pass


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--serve":
        serve(sys.argv[2])
        return
    if len(sys.argv) == 4 and sys.argv[1] == "--wait":
        for _ in range(100):
            os.kill(int(sys.argv[3]), 0)
            if Path(sys.argv[2]).is_socket():
                return
            time.sleep(0.02)
        raise RuntimeError("host browser relay did not start")
    if len(sys.argv) != 2:
        raise ValueError("usage: codex-browser URL")
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(50)
        client.connect(os.environ.get("CODEX_BROWSER_SOCKET", "/codex-browser-relay/socket"))
        client.sendall(json.dumps(sys.argv[1]).encode() + b"\n")
        with client.makefile("rb") as stream:
            response = json.loads(stream.readline(MAX_REQUEST))
        if not response["ok"]:
            raise RuntimeError(response["error"])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        print(f"codex-browser: {error}", file=sys.stderr)
        sys.exit(1)
