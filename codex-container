#!/usr/bin/env bash
set -euo pipefail

# Host-side codex-container wrapper.
#
# It builds (if needed) and runs the OpenAI Codex CLI inside a container,
# mounting the current directory as /workspace. It forwards your host Git
# identity and GitHub token into the container using Podman or Docker.
#
# Configuration (all optional, via environment variables):
#   CONTAINER_ENGINE    podman or docker                (default: auto, prefer podman)
#   IMAGE_NAME          image tag to build/run          (default: codex-container)
#   DOCKERFILE_PATH     path to Dockerfile             (default: next to this script)
#   HOST_CODEX_HOME     host dir for persistent state   (default: XDG_DATA_HOME/codex-cli)
#   CODEX_PROFILE       profile selected at startup     (default: default)
#   CODEX_NTFY_TOPIC    ntfy.sh topic for notifications (default: empty / disabled)
#   CODEX_GITHUB_TOKEN / GH_TOKEN
#                       GitHub token (falls back to `gh auth token`)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

IMAGE_NAME="${IMAGE_NAME:-codex-container}"
WORKDIR_IN_CONTAINER="/workspace"

UID_VALUE="$(id -u)"
GID_VALUE="$(id -g)"
CALLER_PWD="$(pwd)"
HOST_CODEX_HOME="${HOST_CODEX_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/codex-cli}"
PROFILE_NAME="${CODEX_PROFILE:-default}"
CODEX_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        echo "error: --profile requires a profile name" >&2
        exit 1
      fi
      PROFILE_NAME="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE_NAME="${1#--profile=}"
      if [ -z "${PROFILE_NAME}" ]; then
        echo "error: --profile requires a profile name" >&2
        exit 1
      fi
      shift
      ;;
    --)
      CODEX_ARGS+=("$@")
      break
      ;;
    *)
      CODEX_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ ! "${PROFILE_NAME}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
  echo "error: invalid profile name: ${PROFILE_NAME}" >&2
  exit 1
fi

PROFILE_DIR="${SCRIPT_DIR}/profiles/${PROFILE_NAME}"
if [ ! -d "${PROFILE_DIR}" ]; then
  echo "error: profile not found: ${PROFILE_NAME}" >&2
  echo "       expected ${PROFILE_DIR}" >&2
  exit 1
fi
DEFAULT_PROFILE_DIR="${SCRIPT_DIR}/profiles/default"

profile_file() {
  local file_name="$1"

  if [ -e "${PROFILE_DIR}/${file_name}" ]; then
    printf '%s\n' "${PROFILE_DIR}/${file_name}"
  elif [ -e "${DEFAULT_PROFILE_DIR}/${file_name}" ]; then
    printf '%s\n' "${DEFAULT_PROFILE_DIR}/${file_name}"
  else
    echo "error: profile ${PROFILE_NAME} has no ${file_name}, and default has no fallback" >&2
    exit 1
  fi
}

profile_optional_file() {
  local file_name="$1"

  if [ -e "${PROFILE_DIR}/${file_name}" ]; then
    printf '%s\n' "${PROFILE_DIR}/${file_name}"
  fi
}

PROFILE_INIT="$(profile_file init.sh)"
PROFILE_HOOKS="$(profile_file hooks.json)"
PROFILE_INSTRUCTIONS="$(profile_file AGENTS.md)"
PROFILE_CONFIG="$(profile_file config.toml)"
PROFILE_COMMAND="$(profile_optional_file command.sh)"
PROFILE_HOOKS_REL="${PROFILE_HOOKS#"${SCRIPT_DIR}/profiles/"}"
PROFILE_INSTRUCTIONS_REL="${PROFILE_INSTRUCTIONS#"${SCRIPT_DIR}/profiles/"}"
PROFILE_CONFIG_REL="${PROFILE_CONFIG#"${SCRIPT_DIR}/profiles/"}"
PROFILE_COMMAND_REL="${PROFILE_COMMAND#"${SCRIPT_DIR}/profiles/"}"

ENGINE="${CONTAINER_ENGINE:-}"
if [ -z "${ENGINE}" ]; then
  if command -v podman >/dev/null 2>&1; then
    ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then
    ENGINE=docker
  else
    echo "error: neither podman nor docker found on PATH" >&2
    exit 1
  fi
fi
case "${ENGINE}" in
  podman|docker) ;;
  *)
    echo "error: CONTAINER_ENGINE must be podman or docker" >&2
    exit 1
    ;;
esac
if ! command -v "${ENGINE}" >/dev/null 2>&1; then
  echo "error: ${ENGINE} not found on PATH" >&2
  exit 1
fi

CONTAINER_IDENTITY_ARGS=(--security-opt label=disable)
if [ "${ENGINE}" = podman ]; then
  CONTAINER_IDENTITY_ARGS+=(
    --userns=keep-id
    --user "${UID_VALUE}:${GID_VALUE}"
    --group-add keep-groups
  )
else
  if ! DOCKER_SECURITY_OPTIONS="$("${ENGINE}" info --format '{{json .SecurityOptions}}')"; then
    echo "error: cannot access the Docker daemon" >&2
    echo "       check 'docker info', the active Docker context, and socket permissions" >&2
    echo "       configure Docker access for your user; do not run this wrapper with sudo" >&2
    exit 1
  fi
  if [[ "${DOCKER_SECURITY_OPTIONS}" == *'"name=rootless"'* ]]; then
    # Rootless Docker maps container root to the daemon's unprivileged host user.
    # Passing the host UID here would instead select a subordinate host UID.
    CONTAINER_IDENTITY_ARGS+=(--user 0:0)
  else
    # Opt out of daemon userns-remap so bind mounts retain the caller's IDs.
    CONTAINER_IDENTITY_ARGS+=(--userns=host --user "${UID_VALUE}:${GID_VALUE}")
    read -r -a HOST_GROUPS <<< "$(id -G)"
    for group in "${HOST_GROUPS[@]}"; do
      if [ "${group}" != "${GID_VALUE}" ]; then
        CONTAINER_IDENTITY_ARGS+=(--group-add "${group}")
      fi
    done
  fi
fi

DOCKERFILE_PATH="${DOCKERFILE_PATH:-${SCRIPT_DIR}/Dockerfile}"
if [ ! -f "${DOCKERFILE_PATH}" ]; then
  echo "error: Dockerfile not found at ${DOCKERFILE_PATH}" >&2
  echo "       set DOCKERFILE_PATH to point at the Dockerfile" >&2
  exit 1
fi

set -- "${CODEX_ARGS[@]}"

if [[ "${1:-}" == "update" ]]; then
  BACKUP_TAG="backup-$(date +%d%m%Y)"
  echo "Tagging current image as ${IMAGE_NAME%:*}:${BACKUP_TAG} ..."
  "${ENGINE}" tag "${IMAGE_NAME}" "${IMAGE_NAME%:*}:${BACKUP_TAG}"
  echo "Rebuilding ${IMAGE_NAME} (no cache) ..."
  "${ENGINE}" build --no-cache \
    -t "${IMAGE_NAME}" \
    -f "${DOCKERFILE_PATH}" \
    "$(dirname "${DOCKERFILE_PATH}")"
  echo "Done. Previous image kept as ${IMAGE_NAME%:*}:${BACKUP_TAG}"
  exit 0
fi

# Build the image only when it's missing. Use `codex-container update` to
# force a rebuild once the image exists.
if ! "${ENGINE}" image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
  echo "Building ${IMAGE_NAME} (first run) ..." >&2
  "${ENGINE}" build \
    -t "${IMAGE_NAME}" \
    -f "${DOCKERFILE_PATH}" \
    "$(dirname "${DOCKERFILE_PATH}")" >/dev/null
fi

PROFILE_CODEX_HOME="${HOST_CODEX_HOME}/profiles/${PROFILE_NAME}"
SHARED_AUTH_HOME="${HOST_CODEX_HOME}/auth"

# Create the client-side paths for local engines. Pre-create the directories
# needed at launch so setup does not depend on mkdir through the bind mount.
mkdir -p "${PROFILE_CODEX_HOME}/sessions" "${SHARED_AUTH_HOME}"
chmod u+rwx "${PROFILE_CODEX_HOME}" "${PROFILE_CODEX_HOME}/sessions"
chmod 700 "${SHARED_AUTH_HOME}"

if [ ! -w "${PROFILE_CODEX_HOME}" ]; then
  echo "error: profile state is not writable: ${PROFILE_CODEX_HOME}" >&2
  echo "       fix host ownership/permissions before launching Codex" >&2
  exit 1
fi
PROFILE_CODEX_HOME="$(cd "${PROFILE_CODEX_HOME}" && pwd)"
SHARED_AUTH_HOME="$(cd "${SHARED_AUTH_HOME}" && pwd)"

# Carry the host Git identity into the container so commits use the same
# author as the surrounding host checkout.
HOST_GIT_NAME="$(git config --get user.name 2>/dev/null || true)"
HOST_GIT_EMAIL="$(git config --get user.email 2>/dev/null || true)"
GIT_IDENTITY_ARGS=()
if [ -n "${HOST_GIT_NAME}" ]; then
  GIT_IDENTITY_ARGS+=(
    -e GIT_AUTHOR_NAME="${HOST_GIT_NAME}"
    -e GIT_COMMITTER_NAME="${HOST_GIT_NAME}"
  )
fi
if [ -n "${HOST_GIT_EMAIL}" ]; then
  GIT_IDENTITY_ARGS+=(
    -e GIT_AUTHOR_EMAIL="${HOST_GIT_EMAIL}"
    -e GIT_COMMITTER_EMAIL="${HOST_GIT_EMAIL}"
  )
fi

# Mounted outside of /tmp/home: bind-mounting directly into /tmp/home
# would make the container engine auto-create /tmp/home as root before
# the container's non-root user starts, breaking later mkdir calls
# (e.g. Codex's own /tmp/home/.cache). GIT_CONFIG_GLOBAL (git >= 2.32)
# lets us point git at it without touching /tmp/home at all.
GITCONFIG_MOUNT_ARGS=()
if [ -f "${HOME}/.gitconfig" ]; then
  GITCONFIG_MOUNT_ARGS+=(
    -v "${HOME}/.gitconfig:/tmp/host-gitconfig:ro"
    -e GIT_CONFIG_GLOBAL=/tmp/host-gitconfig
  )
fi

# Use private, unique probes so concurrent launches cannot clobber each other
# or a pre-existing file. Check ownership on the host, not inside a user namespace.
check_bind_write() (
  host_path="$1"
  container_path="$2"
  shift 2
  if ! probe_dir="$(mktemp -d "${host_path}/.codex-write-test.XXXXXXXXXX")"; then
    echo "error: cannot prepare ${container_path} write probe in ${host_path}" >&2
    echo "       fix host ownership/permissions before launching Codex" >&2
    exit 1
  fi
  trap 'rm -f -- "${probe_dir}/owner"; rmdir -- "${probe_dir}"' EXIT

  if ! "${ENGINE}" run \
    --rm --network=none \
    "${CONTAINER_IDENTITY_ARGS[@]}" \
    -v "${host_path}:${container_path}" \
    "${IMAGE_NAME}" bash -c '
      set -eu
      owner_file="$1"
      shift
      : > "$owner_file"
      probe=""
      trap '\''[ -z "$probe" ] || rm -f -- "$probe"'\'' EXIT
      for directory in "$@"; do
        probe="$(mktemp "$directory/.codex-write-test.XXXXXXXXXX")"
        rm -f -- "$probe"
        probe=""
      done
    ' bash "${container_path}/${probe_dir##*/}/owner" "${container_path}" "$@"; then
    echo "error: ${container_path} is not writable through ${ENGINE}" >&2
    echo "       host path: ${host_path}" >&2
    echo "       check the engine error above and host ownership/permissions" >&2
    echo "       use a local daemon; rootless Docker must run as your user and cannot retain host supplementary groups" >&2
    exit 1
  fi
  if [ ! -O "${probe_dir}/owner" ]; then
    echo "error: ${ENGINE} did not create a file owned by your host user in ${host_path}" >&2
    echo "       use a local daemon with matching user mappings (rootless Docker must run as your user)" >&2
    exit 1
  fi
)

check_bind_write "${CALLER_PWD}" "${WORKDIR_IN_CONTAINER}"
check_bind_write "${PROFILE_CODEX_HOME}" /codex-state /codex-state/sessions
check_bind_write "${SHARED_AUTH_HOME}" /codex-auth

GITHUB_TOKEN=""
if [ -n "${CODEX_GITHUB_TOKEN:-}" ]; then
  GITHUB_TOKEN="${CODEX_GITHUB_TOKEN}"
elif [ -n "${GH_TOKEN:-}" ]; then
  GITHUB_TOKEN="${GH_TOKEN}"
elif command -v gh >/dev/null 2>&1; then
  if ! GITHUB_TOKEN="$(gh auth token)" || [ -z "${GITHUB_TOKEN}" ]; then
    echo "warning: no GitHub token available; PR workflows require GH_TOKEN or 'gh auth login' on the host" >&2
    GITHUB_TOKEN=""
  fi
fi

# Let the engine inherit the resolved token without exposing it in argv.
export GH_TOKEN="${GITHUB_TOKEN}"

set -- bash /codex-container-init "$@"

RUN_ARGS=(
  --rm
  -it
  -w "${WORKDIR_IN_CONTAINER}"
  -e HOME=/tmp/home
  -e CODEX_HOME=/codex-state
  -e CODEX_AUTH_HOME=/codex-auth
  -e GH_TOKEN
  -e CODEX_NTFY_TOPIC="${CODEX_NTFY_TOPIC:-}"
  -e CODEX_PROFILE_INIT="/codex-profiles/${PROFILE_INIT#"${SCRIPT_DIR}/profiles/"}"
  -e CODEX_PROFILE_HOOKS="/codex-profiles/${PROFILE_HOOKS_REL}"
  -e CODEX_PROFILE_INSTRUCTIONS="/codex-profiles/${PROFILE_INSTRUCTIONS_REL}"
  -e CODEX_PROFILE_CONFIG="/codex-profiles/${PROFILE_CONFIG_REL}"
  -e CODEX_PROFILE_COMMAND="${PROFILE_COMMAND_REL:+/codex-profiles/${PROFILE_COMMAND_REL}}"
  -v "${SCRIPT_DIR}/profiles:/codex-profiles:ro"
  -v "${SCRIPT_DIR}/codex-container-init:/codex-container-init:ro"
  --network=host
  ${GIT_IDENTITY_ARGS[@]+"${GIT_IDENTITY_ARGS[@]}"}
  ${GITCONFIG_MOUNT_ARGS[@]+"${GITCONFIG_MOUNT_ARGS[@]}"}
)

RUN_ARGS+=(
  "${CONTAINER_IDENTITY_ARGS[@]}"
  -v "${CALLER_PWD}:${WORKDIR_IN_CONTAINER}"
  -v "${PROFILE_CODEX_HOME}:/codex-state"
  -v "${SHARED_AUTH_HOME}:/codex-auth"
)

exec "${ENGINE}" run "${RUN_ARGS[@]}" "${IMAGE_NAME}" "$@"
