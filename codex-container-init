#!/usr/bin/env bash
set -euo pipefail

mkdir -p "$HOME" "$CODEX_HOME" "$CODEX_AUTH_HOME"
if [ -s "$CODEX_PROFILE_HOOKS" ]; then
  cp "$CODEX_PROFILE_HOOKS" "$CODEX_HOME/hooks.json"
else
  rm -f -- "$CODEX_HOME/hooks.json"
fi
cp "$CODEX_PROFILE_INSTRUCTIONS" "$CODEX_HOME/AGENTS.md"
cp "$CODEX_PROFILE_CONFIG" "$CODEX_HOME/container.config.toml"

args=("$@")
cli_command=""
cli_subcommand=""
cli_info=false
for ((index = 0; index < ${#args[@]}; index++)); do
  case "${args[index]}" in
    -c|--config|-m|--model|-C|--cd|-s|--sandbox|-a|--ask-for-approval|-p|--enable|--disable|--remote|--remote-auth-token-env|--local-provider|--add-dir|-i|--image)
      index=$((index + 1))
      ;;
    -h|--help|-V|--version)
      cli_info=true
      ;;
    --)
      break
      ;;
    -*)
      ;;
    *)
      if [ -z "$cli_command" ]; then
        cli_command="${args[index]}"
        cli_subcommand="${args[index + 1]:-}"
      fi
      ;;
  esac
done

# Login/logout must operate on the shared directory: logout unlinks auth.json.
case "$cli_command" in
  login|logout)
    export CODEX_HOME="$CODEX_AUTH_HOME"
    exec codex -c 'cli_auth_credentials_store="file"' "$@"
    ;;
esac
ln -sfn "$CODEX_AUTH_HOME/auth.json" "$CODEX_HOME/auth.json"

if [ "${1:-}" = bash ]; then
  shift
  exec bash "$@"
fi

# Codex does not accept configuration profiles for these management commands.
case "$cli_command" in
  plugin|features|completion|doctor|app-server|remote-control|cloud|apply|execpolicy|migrate-rollouts)
    exec codex -c 'cli_auth_credentials_store="file"' "$@"
    ;;
  debug)
    if [ "$cli_subcommand" != prompt-input ]; then
      exec codex -c 'cli_auth_credentials_store="file"' "$@"
    fi
    ;;
esac

# Only session commands run retention, including profile workflow commands.
cleanup_sessions=true
case "$cli_command" in
  help|agents|mcp|sandbox|queue|archive|unarchive|delete|update|exec-server|a)
    cleanup_sessions=false
    ;;
esac
if ! "$cli_info" && "$cleanup_sessions"; then
python3 - <<'PY'
from datetime import datetime, timedelta, timezone
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
from uuid import UUID


def walk_error(error):
    raise error


home = Path(os.environ["CODEX_HOME"])
try:
    marker = home / ".session-cleanup-last-run"
    now = datetime.now(timezone.utc)
    today = now.date().isoformat()
    if marker.exists() and marker.read_text(errors="replace").strip() == today:
        sys.exit(0)
    cutoff = (now - timedelta(days=14)).timestamp()
    modified = {}
    for name in ("sessions", "archived_sessions"):
        directory = home / name
        if directory.is_symlink() or not directory.exists():
            continue
        for parent, _, filenames in os.walk(directory, onerror=walk_error):
            for filename in filenames:
                match = re.fullmatch(
                    r"rollout-.+-([0-9a-f-]{36})(?:_[0-9a-f-]{36})?\.jsonl(?:\.zst)?",
                    filename,
                )
                if not match:
                    continue
                session_id = str(UUID(match[1]))
                try:
                    info = (Path(parent) / filename).lstat()
                    if stat.S_ISREG(info.st_mode):
                        modified[session_id] = max(modified.get(session_id, 0), info.st_mtime)
                except FileNotFoundError:
                    pass
    failed = False
    for session_id, mtime in modified.items():
        if mtime >= cutoff:
            continue
        # Codex checks live writers and history references and updates its indexes.
        result = subprocess.run(
            ["codex", "--no-daemon", "delete", "--force", session_id],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
            timeout=30,
        )
        if result.returncode:
            failed = True
            print(f"warning: session cleanup failed for {session_id}: {result.stderr.strip()}",
                  file=sys.stderr)
    if not failed:
        marker.write_text(today + "\n")
except (OSError, ValueError, subprocess.TimeoutExpired) as error:
    print(f"warning: session cleanup failed: {error}", file=sys.stderr)
PY
fi

# Trust the launch directory and any --cd target on every invocation. Include
# parent directories so project configuration discovered there is loaded too.
# Keep this in CLI defaults rather than rewriting private persisted config.
export CODEX_CONTAINER_TRUST_CONFIG
CODEX_CONTAINER_TRUST_CONFIG="$(python3 - "$@" <<'PY'
import json
from pathlib import Path
import sys

cwd = Path.cwd()
target = cwd
args = iter(sys.argv[1:])
for arg in args:
    if arg == "--":
        break
    if arg in ("-c", "--config", "-m", "--model", "-p", "--profile",
               "-s", "--sandbox", "-a", "--ask-for-approval", "--enable",
               "--disable", "--remote", "--remote-auth-token-env",
               "--local-provider", "--add-dir", "-i", "--image"):
        next(args, None)
    elif arg in ("-C", "--cd"):
        target = cwd / next(args, ".")
    elif arg.startswith("--cd="):
        target = cwd / arg.partition("=")[2]
    elif arg.startswith("-C"):
        target = cwd / arg[2:]

paths = set()
for directory in (cwd, target.resolve()):
    paths.update((directory, *directory.parents))
print("projects={" + ",".join(
    json.dumps(str(path), ensure_ascii=False) + '={trust_level="trusted"}'
    for path in sorted(paths)
) + "}")
PY
)"

bash "$CODEX_PROFILE_INIT"
if [ -n "${CODEX_PROFILE_COMMAND:-}" ] && [ -s "$CODEX_PROFILE_COMMAND" ]; then
  exec bash "$CODEX_PROFILE_COMMAND" "$@"
fi
exec codex --profile container --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust -c 'cli_auth_credentials_store="file"' -c "$CODEX_CONTAINER_TRUST_CONFIG" "$@"
